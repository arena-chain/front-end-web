### Step 2: Create Tournament API Service

**File**: `lib/services/tournament_service.dart`

```dart
// lib/services/tournament_service.dart
import 'dart:convert';
import 'package:http/http.dart' as http;
import '../models/tournament_model.dart';

class TournamentService {
  final String baseUrl = 'http://localhost:3000/tournements';
  
  // Get auth token from storage (adjust based on your auth implementation)
  Future<String?> _getAuthToken() async {
    // TODO: Implement token retrieval from SharedPreferences or SecureStorage
    // For now, return null or hardcoded token
    return null;
  }

  Future<Map<String, String>> _getHeaders() async {
    final token = await _getAuthToken();
    return {
      'Content-Type': 'application/json',
      if (token != null) 'Authorization': 'Bearer $token',
    };
  }

  /// Get all tournaments
  Future<List<Tournament>> getAllTournaments() async {
    try {
      final headers = await _getHeaders();
      final response = await http.get(
        Uri.parse(baseUrl),
        headers: headers,
      );

      if (response.statusCode == 200) {
        final List<dynamic> data = json.decode(response.body);
        return data.map((json) => Tournament.fromJson(json)).toList();
      } else {
        throw Exception('Failed to load tournaments: ${response.statusCode}');
      }
    } catch (e) {
      throw Exception('Error fetching tournaments: $e');
    }
  }

  /// Get tournament by ID
  Future<Tournament> getTournamentById(String id) async {
    try {
      final headers = await _getHeaders();
      final response = await http.get(
        Uri.parse('$baseUrl/$id'),
        headers: headers,
      );

      if (response.statusCode == 200) {
        return Tournament.fromJson(json.decode(response.body));
      } else {
        throw Exception('Failed to load tournament: ${response.statusCode}');
      }
    } catch (e) {
      throw Exception('Error fetching tournament: $e');
    }
  }

  /// Create a new tournament (RANKED)
  Future<Tournament> createTournament({
    required String name,
    required String description,
    required String gameId,
    required String organizerId, // Current user ID
    required DateTime startDate,
    required DateTime endDate,
    required int maxTeams,
    required String format,
    double prizePool = 0,
    double firstPlace = 0,
    double secondPlace = 0,
    double thirdPlace = 0,
    Map<String, dynamic>? rules,
  }) async {
    try {
      final headers = await _getHeaders();
      final body = {
        'name': name,
        'description': description,
        'gameId': gameId,
        'organizerId': organizerId,
        'startDate': startDate.toIso8601String(),
        'endDate': endDate.toIso8601String(),
        'maxTeams': maxTeams,
        'format': format,
        'prizePool': prizePool,
        'firstPlace': firstPlace,
        'secondPlace': secondPlace,
        'thirdPlace': thirdPlace,
        'rules': rules ?? {},
        'registrationOpen': true,
      };

      final response = await http.post(
        Uri.parse(baseUrl),
        headers: headers,
        body: json.encode(body),
      );

      if (response.statusCode == 201) {
        return Tournament.fromJson(json.decode(response.body));
      } else {
        throw Exception('Failed to create tournament: ${response.body}');
      }
    } catch (e) {
      throw Exception('Error creating tournament: $e');
    }
  }

  /// Register a team for a tournament
  Future<Tournament> registerTeam(String tournamentId, String teamId) async {
    try {
      final headers = await _getHeaders();
      final response = await http.post(
        Uri.parse('$baseUrl/$tournamentId/register-team'),
        headers: headers,
        body: json.encode({'teamId': teamId}),
      );

      if (response.statusCode == 200) {
        return Tournament.fromJson(json.decode(response.body));
      } else {
        throw Exception('Failed to register team: ${response.body}');
      }
    } catch (e) {
      throw Exception('Error registering team: $e');
    }
  }

  /// Unregister a team from a tournament
  Future<Tournament> unregisterTeam(String tournamentId, String teamId) async {
    try {
      final headers = await _getHeaders();
      final response = await http.delete(
        Uri.parse('$baseUrl/$tournamentId/unregister-team/$teamId'),
        headers: headers,
      );

      if (response.statusCode == 200) {
        return Tournament.fromJson(json.decode(response.body));
      } else {
        throw Exception('Failed to unregister team: ${response.body}');
      }
    } catch (e) {
      throw Exception('Error unregistering team: $e');
    }
  }

  /// Filter tournaments by status
  Future<List<Tournament>> getTournamentsByStatus(String status) async {
    final allTournaments = await getAllTournaments();
    return allTournaments.where((t) => t.status == status).toList();
  }

  /// Filter tournaments: Official vs Ranked
  Future<List<Tournament>> getRankedTournaments() async {
    final allTournaments = await getAllTournaments();
    // Assuming "ranked" tournaments are user-created (you may add a field to distinguish)
    return allTournaments.where((t) => t.status != 'DRAFT').toList();
  }
}
```

