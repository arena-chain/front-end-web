# Tournament Mobile Integration Guide - Flutter

## 📋 Overview

This guide shows how to integrate tournaments into your Flutter mobile app, allowing users to:
- **View all tournaments** (Official and Ranked)
- **Create ranked tournaments** (user-generated)
- **Register teams** for tournaments
- **View tournament details** and phases
- **Track tournament progress**

---

## 🎯 Backend API Reference

### Base URL
```
http://localhost:3000/tournements
```

### Available Endpoints

#### 1. Get All Tournaments
```http
GET /tournements
```
**Response**: Array of tournaments

#### 2. Get Tournament by ID
```http
GET /tournements/:id
```
**Response**: Tournament object with populated gameId and teams

#### 3. Create Tournament (Ranked)
```http
POST /tournements
Content-Type: multipart/form-data
```
**Body**:
```json
{
  "name": "Summer Clash 2026",
  "description": "Community ranked tournament",
  "gameId": "6984cd35758c2d90894d5817",
  "organizerId": "user_id_here",
  "startDate": "2026-12-01T10:00:00.000Z",
  "endDate": "2026-12-05T20:00:00.000Z",
  "maxTeams": 16,
  "prizePool": 5000,
  "firstPlace": 2500,
  "secondPlace": 1500,
  "thirdPlace": 1000,
  "format": "SINGLE_ELIMINATION",
  "registrationOpen": true
}
```

#### 4. Register Team
```http
POST /tournements/:id/register-team
Content-Type: application/json
```
**Body**:
```json
{
  "teamId": "team_id_here"
}
```

#### 5. Unregister Team
```http
DELETE /tournements/:id/unregister-team/:teamId
```

---

## 🏗️ Flutter Implementation

### Step 1: Create Tournament Models

**File**: `lib/models/tournament_model.dart`

```dart
// lib/models/tournament_model.dart

enum TournamentFormat {
  SINGLE_ELIMINATION,
  DOUBLE_ELIMINATION,
  SWISS,
  ROUND_ROBIN,
}

enum TournamentStatus {
  DRAFT,
  OPEN_REGISTRATION,
  ONGOING,
  COMPLETED,
  CANCELLED,
}

enum PhaseName {
  PLAY_IN,
  GROUP_STAGE,
  QUARTERFINALS,
  SEMIFINALS,
  FINALS,
}

class TournamentPhase {
  final String name;
  final String status; // PENDING, ONGOING, COMPLETED
  final DateTime? startDate;
  final DateTime? endDate;
  final List<String> matches;

  TournamentPhase({
    required this.name,
    required this.status,
    this.startDate,
    this.endDate,
    this.matches = const [],
  });

  factory TournamentPhase.fromJson(Map<String, dynamic> json) {
    return TournamentPhase(
      name: json['name'] ?? '',
      status: json['status'] ?? 'PENDING',
      startDate: json['startDate'] != null 
          ? DateTime.parse(json['startDate']) 
          : null,
      endDate: json['endDate'] != null 
          ? DateTime.parse(json['endDate']) 
          : null,
      matches: List<String>.from(json['matches'] ?? []),
    );
  }

  Map<String, dynamic> toJson() {
    return {
      'name': name,
      'status': status,
      'startDate': startDate?.toIso8601String(),
      'endDate': endDate?.toIso8601String(),
      'matches': matches,
    };
  }
}

class Tournament {
  final String id;
  final String name;
  final String? description;
  final String gameId;
  final String organizerId;
  final DateTime startDate;
  final DateTime endDate;
  final DateTime? registrationStart;
  final DateTime? registrationEnd;
  final int maxTeams;
  final int currentTeams;
  final List<String> teams;
  final bool registrationOpen;
  final double prizePool;
  final double firstPlace;
  final double secondPlace;
  final double thirdPlace;
  final String format; // TournamentFormat
  final List<TournamentPhase> phases;
  final String status; // TournamentStatus
  final Map<String, dynamic> rules;
  final String? bannerImageUrl;
  final String? streamUrl;
  final DateTime createdAt;
  final DateTime updatedAt;

  Tournament({
    required this.id,
    required this.name,
    this.description,
    required this.gameId,
    required this.organizerId,
    required this.startDate,
    required this.endDate,
    this.registrationStart,
    this.registrationEnd,
    required this.maxTeams,
    this.currentTeams = 0,
    this.teams = const [],
    this.registrationOpen = true,
    this.prizePool = 0,
    this.firstPlace = 0,
    this.secondPlace = 0,
    this.thirdPlace = 0,
    required this.format,
    this.phases = const [],
    this.status = 'DRAFT',
    this.rules = const {},
    this.bannerImageUrl,
    this.streamUrl,
    required this.createdAt,
    required this.updatedAt,
  });

  factory Tournament.fromJson(Map<String, dynamic> json) {
    return Tournament(
      id: json['_id'] ?? '',
      name: json['name'] ?? '',
      description: json['description'],
      gameId: json['gameId'] is String 
          ? json['gameId'] 
          : json['gameId']?['_id'] ?? '',
      organizerId: json['organizerId'] ?? '',
      startDate: DateTime.parse(json['startDate']),
      endDate: DateTime.parse(json['endDate']),
      registrationStart: json['registrationStart'] != null
          ? DateTime.parse(json['registrationStart'])
          : null,
      registrationEnd: json['registrationEnd'] != null
          ? DateTime.parse(json['registrationEnd'])
          : null,
      maxTeams: json['maxTeams'] ?? 0,
      currentTeams: json['currentTeams'] ?? 0,
      teams: List<String>.from(json['teams'] ?? []),
      registrationOpen: json['registrationOpen'] ?? true,
      prizePool: (json['prizePool'] ?? 0).toDouble(),
      firstPlace: (json['firstPlace'] ?? 0).toDouble(),
      secondPlace: (json['secondPlace'] ?? 0).toDouble(),
      thirdPlace: (json['thirdPlace'] ?? 0).toDouble(),
      format: json['format'] ?? 'SINGLE_ELIMINATION',
      phases: (json['phases'] as List?)
              ?.map((p) => TournamentPhase.fromJson(p))
              .toList() ??
          [],
      status: json['status'] ?? 'DRAFT',
      rules: Map<String, dynamic>.from(json['rules'] ?? {}),
      bannerImageUrl: json['bannerImageUrl'],
      streamUrl: json['streamUrl'],
      createdAt: DateTime.parse(json['createdAt']),
      updatedAt: DateTime.parse(json['updatedAt']),
    );
  }

  Map<String, dynamic> toJson() {
    return {
      'name': name,
      'description': description,
      'gameId': gameId,
      'organizerId': organizerId,
      'startDate': startDate.toIso8601String(),
      'endDate': endDate.toIso8601String(),
      'registrationStart': registrationStart?.toIso8601String(),
      'registrationEnd': registrationEnd?.toIso8601String(),
      'maxTeams': maxTeams,
      'prizePool': prizePool,
      'firstPlace': firstPlace,
      'secondPlace': secondPlace,
      'thirdPlace': thirdPlace,
      'format': format,
      'rules': rules,
      'bannerImageUrl': bannerImageUrl,
      'streamUrl': streamUrl,
      'registrationOpen': registrationOpen,
    };
  }

  // Helper getters
  bool get isFull => currentTeams >= maxTeams;
  bool get canRegister => registrationOpen && !isFull;
  bool get isRanked => status != 'DRAFT'; // User can distinguish ranked vs official
}
```

